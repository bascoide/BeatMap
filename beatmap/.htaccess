<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Abrir a raiz diretamente em views/index.php
    DirectoryIndex views/index.php index.php
    
    # Se a pasta views/email não existir como ficheiro real, reescreve
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Reescreve URLs para ficheiros em views/
    RewriteRule ^([a-zA-Z0-9_-]+)\.php$ views/$1.php [QSA,L]
    
    # Reescreve para email views
    RewriteRule ^email/([a-zA-Z0-9_-]+)\.php$ views/email/$1.php [QSA,L]
</IfModule>

ErrorDocument 404 /404error.html

# Segurança básica
<FilesMatch "\.php$">
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
    </IfModule>
</FilesMatch>
